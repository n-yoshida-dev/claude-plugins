{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(claude plugin validate *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr merge *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(git switch main)",
      "Bash(git pull)"
    ],
    "deny": [
      "Bash(git add -f *)",
      "Bash(git add --force *)"
    ]
  }
}
